<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: bulut yedeği ve cihazdan cihaza aktarımda hiçbir uygulama
     verisi taşınmaz (oturum anahtarı yeni cihaza kopyalanmasın). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
